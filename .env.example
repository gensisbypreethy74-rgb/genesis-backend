# Genesis backend — environment template.
# Copy to .env for local development. Never commit real values.
# Production values belong in Render → genesis-backend → Environment.

# ── Runtime ───────────────────────────────────────────────────────────────
# "production" on Render (stack traces hidden, rate limits on, config checked
# at boot). Unset also means production. Use "development" only locally.
NODE_ENV=development
# Local only. Render assigns PORT itself; don't set it there.
PORT=5000

# ── Database (required) ───────────────────────────────────────────────────
# MongoDB Atlas → Database → Connect → Drivers. Use a separate database name
# for local development so local testing never touches production data.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# ── Sessions (required) ───────────────────────────────────────────────────
# Random string, 32+ characters. Changing it signs everyone out.
JWT_SECRET=<random-32+-character-string>
# Optional. Defaults: customers 7d, admins 12h.
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h

# ── URLs ──────────────────────────────────────────────────────────────────
# Required in production. Used for links in emails. Live: https://genesisbypreethy.com
FRONTEND_URL=http://localhost:3000
# Optional extra browser origins, comma-separated (e.g. a Vercel preview URL).
# The three live domains and localhost (local only) are built into the code.
CORS_ORIGIN=

# ── Google sign-in (required) ─────────────────────────────────────────────
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Web client ID.
# Must be identical to the storefront's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# No client secret is needed: the backend checks tokens with Google directly.
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# ── Razorpay (key pair required in production) ────────────────────────────
# Razorpay Dashboard → Account & Settings → API Keys. Use rzp_test_ keys locally.
RAZORPAY_KEY_ID=rzp_test_<key-id>
RAZORPAY_KEY_SECRET=<key-secret>
# Razorpay Dashboard → Webhooks → the secret you set when adding
# https://<backend-host>/api/v1/payments/webhook (events: payment.captured, order.paid).
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>

# ── Cloudinary (required for admin image uploads) ─────────────────────────
# Cloudinary Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# ── Email via SendGrid (optional; emails are skipped unless both are set) ─
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
FROM_NAME=Genesis by Preethy

# ── Newsletter via Zoho Campaigns (optional; all of these or none) ────────
# Zoho data centre suffix: "in" for India accounts (zoho.in), else com/eu/com.au/jp.
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Generate with: npx ts-node getZohoRefreshToken.ts <grant-code>
ZOHO_REFRESH_TOKEN=
ZOHO_LIST_KEY=

# ── createAdmin.ts only (pass on the command line; never set on Render) ───
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
